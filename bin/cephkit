"""Run cephkit from a checkout.

Works when symlinked into PATH: the checkout is found from this file's real
location, not from the symlink.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from cephkit.cli import main

sys.exit(main())
